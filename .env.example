# Домен, на который nginx-proxy проксирует трафик.
VIRTUAL_HOST=bigvibecourse.freedynamicdns.net

# Домен(ы) для Let's Encrypt (через запятую).
LETSENCRYPT_HOST=bigvibecourse.freedynamicdns.net

# Email для регистрации в Let's Encrypt (используется для уведомлений
# об истечении сертификата).
LETSENCRYPT_EMAIL=admin@bigvibecourse.freedynamicdns.net
# Явный upstream-порт. У nginx:alpine в базовом образе есть EXPOSE 80,
# а у нашего Dockerfile — ещё и EXPOSE 3000; nginx-proxy по умолчанию
# берёт первый и стучится на 80, поэтому фиксируем порт здесь.
VIRTUAL_PORT=3000
