[Unit]
Description=Big Vibe Video (Vue SPA via Docker)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/big-vibe-video
ExecStart=/usr/bin/docker run -d --name big-vibe-video --restart unless-stopped -p 3000:3000 big-vibe-video:latest
ExecStop=/usr/bin/docker stop big-vibe-video
ExecStopPost=-/usr/bin/docker rm -f big-vibe-video
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
